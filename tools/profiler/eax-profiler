#!/usr/bin/env bash
# Starts the game profile editor (or just opens it, if it is already running).
# Usage: tools/profiler/eax-profiler [--port N]    (see README.md for the one-time app-menu entry)
set -u
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
port=8765
[ "${1:-}" == "--port" ] && [ -n "${2:-}" ] && port="$2"
url="http://127.0.0.1:$port/"

# The editor's own pings tell us it is running; a second launch only needs the browser.
open_page() {
    if command -v chromium >/dev/null 2>&1; then chromium --app="$url" >/dev/null 2>&1 &
    elif command -v google-chrome >/dev/null 2>&1; then google-chrome --app="$url" >/dev/null 2>&1 &
    else xdg-open "$url" >/dev/null 2>&1 &
    fi
}

fail() {
    echo "Game profile editor: $1" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send "Game profile editor" "$1"
    exit 1
}

if curl -fs --max-time 2 "${url}api/ping" >/dev/null 2>&1; then
    open_page
    exit 0
fi

command -v python3 >/dev/null 2>&1 || fail "python3 is needed to run it."
python3 -c 'import jsonschema' 2>/dev/null || fail "the Python package jsonschema is missing (install python-jsonschema)."
cd "$repo" || fail "can't find the repository at $repo."
# Capturing runs the built installer, so build it once if it isn't there.
[ -f dist/eax-restore-linux.sh ] || ./build.sh >/dev/null 2>&1 || fail "building dist/eax-restore-linux.sh failed; run ./build.sh to see why."

# The editor stops itself some minutes after its page is closed, so no terminal is needed.
# It opens a browser tab by itself unless the --app window above is available.
if command -v chromium >/dev/null 2>&1 || command -v google-chrome >/dev/null 2>&1; then
    python3 tools/profiler/profiler.py --port "$port" --no-open --quit-when-closed &
    pid=$!
    for _ in $(seq 1 40); do curl -fs --max-time 1 "${url}api/ping" >/dev/null 2>&1 && break; sleep 0.25; done
    open_page
    wait "$pid"
else
    exec python3 tools/profiler/profiler.py --port "$port" --quit-when-closed
fi
