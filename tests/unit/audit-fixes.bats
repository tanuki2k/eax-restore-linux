#!/usr/bin/env bats
# Regressions from the script audit: manifest handling, backups, Heroic
# records, typed paths and the database's alsoft_tested flag.

load ../helpers

setup() {
    load_script_functions
    source "$REPO_ROOT/src/game-database.sh"
    source "$REPO_ROOT/src/detection.sh" 2>/dev/null || true
    source "$REPO_ROOT/src/cache.sh" 2>/dev/null || true
}

@test "alsoft_tested: false is read as false, an absent flag as true" {
    GAME_DATABASE_FILE="$BATS_TEST_TMPDIR/db.json"
    echo '{"games":[{"id":"g","stores":{"steam":{"id":1}},"install":{"alsoft_ini":{"reverb":{"boost":"6"}},"alsoft_tested":false}},
                      {"id":"h","stores":{"steam":{"id":2}},"install":{"alsoft_ini":{"reverb":{"boost":"6"}}}}]}' > "$GAME_DATABASE_FILE"
    run gdb_jq 1 steam 'entry0 | (.install.alsoft_tested | if . == null then true else . end)'
    [ "$output" == "false" ]
    run gdb_jq 2 steam 'entry0 | (.install.alsoft_tested | if . == null then true else . end)'
    [ "$output" == "true" ]
}

@test "manifest_file_is_ours: only the names the install deploys" {
    manifest_file_is_ours /g/dsound.dll
    manifest_file_is_ours /g/DSOUND.DLL
    manifest_file_is_ours /g/alsoft.ini
    ! manifest_file_is_ours /home/u/Documents
    ! manifest_file_is_ours /g/game.exe
}

@test "looks_like_our_file: DSOAL and generated files yes, a game's own no" {
    printf 'xxDSOALxx' > "$BATS_TEST_TMPDIR/dsound.dll"
    looks_like_our_file "$BATS_TEST_TMPDIR/dsound.dll"
    printf 'MZ genuine' > "$BATS_TEST_TMPDIR/other.dll"; mkdir "$BATS_TEST_TMPDIR/g"
    printf 'MZ genuine' > "$BATS_TEST_TMPDIR/g/dsound.dll"
    ! looks_like_our_file "$BATS_TEST_TMPDIR/g/dsound.dll"
    : > "$BATS_TEST_TMPDIR/g/eax.dll"
    looks_like_our_file "$BATS_TEST_TMPDIR/g/eax.dll"
    printf '# Auto-generated by EAX Restore Script for Linux\n' > "$BATS_TEST_TMPDIR/g/alsoft.ini"
    looks_like_our_file "$BATS_TEST_TMPDIR/g/alsoft.ini"
    printf '[general]\n' > "$BATS_TEST_TMPDIR/g/alsoft.ini"
    ! looks_like_our_file "$BATS_TEST_TMPDIR/g/alsoft.ini"
}

@test "oldest_backup: by the timestamp in the name, ignoring other .bak files" {
    f="$BATS_TEST_TMPDIR/dsound.dll"
    : > "$f.bak.20240102_000000"; : > "$f.bak.20230101_000000"; : > "$f.bak-mine"
    touch -d '2020-01-01' "$f.bak.20240102_000000"
    [ "$(oldest_backup "$f")" == "$f.bak.20230101_000000" ]
    rm "$f".bak.2*
    ! oldest_backup "$f"
}

@test "manifest_forget_paths drops exactly those lines" {
    INSTALL_MANIFEST="$BATS_TEST_TMPDIR/m.txt"
    printf '%s\n' "# EAX Restore manifest, format 2" /g/dsound.dll /g/alsoft.ini "REGISTRY:COM" > "$INSTALL_MANIFEST"
    manifest_forget_paths /g/dsound.dll
    [ "$(cat "$INSTALL_MANIFEST")" == "$(printf '%s\n' "# EAX Restore manifest, format 2" /g/alsoft.ini "REGISTRY:COM")" ]
}

@test "manifest_dedupe keeps the first of each line" {
    INSTALL_MANIFEST="$BATS_TEST_TMPDIR/m.txt"
    printf '%s\n' "VCRUN" /g/a.dll "VCRUN" /g/a.dll > "$INSTALL_MANIFEST"
    manifest_dedupe
    [ "$(cat "$INSTALL_MANIFEST")" == "$(printf '%s\n' VCRUN /g/a.dll)" ]
}

@test "heroic_installed_records: a comma in the install path survives" {
    echo '{"installed":[{"install_path":"/g/Test, Part 1/Game","appName":"abc"}]}' > "$BATS_TEST_TMPDIR/installed.json"
    run heroic_installed_records "$BATS_TEST_TMPDIR/installed.json"
    [ "$output" == $'/g/Test, Part 1/Game\tabc' ]
}

@test "clean_typed_path expands only ~ and ~/..." {
    HOME=/home/u
    [ "$(clean_typed_path '~/games')" == "/home/u/games" ]
    [ "$(clean_typed_path '~')" == "/home/u" ]
    [ "$(clean_typed_path '~foo')" == "~foo" ]
}

@test "verify_checksum fails when sha256sum is missing" {
    printf x > "$BATS_TEST_TMPDIR/f"
    PATH="$BATS_TEST_TMPDIR/nopath" run verify_checksum "$BATS_TEST_TMPDIR/f" deadbeef
    [ "$status" -eq 1 ]
}

@test "launch options: an & in the options or log path is kept as typed" {
    run launch_options_with_override 'WINEDLLOVERRIDES="d3d9=n" MY=a&b %command%' dsound
    [[ "$output" == *'MY=a&b %command%' ]]
    [[ "$output" != *'WINEDLLOVERRIDES="d3d9=n" '* ]]
    run launch_options_with_dsoal_log 'FOO=1 %command% -x' 4 'Z:/g/Rock & Roll/dsoal.log'
    [ "$output" == 'FOO=1 DSOAL_LOGLEVEL=4 DSOAL_LOGFILE="Z:/g/Rock & Roll/dsoal.log" %command% -x' ]
}

@test "swap_in writes through a symlink and keeps it a symlink" {
    echo old > "$BATS_TEST_TMPDIR/real.json"
    ln -s real.json "$BATS_TEST_TMPDIR/link.json"
    echo new > "$BATS_TEST_TMPDIR/tmp"
    swap_in "$BATS_TEST_TMPDIR/tmp" "$BATS_TEST_TMPDIR/link.json"
    [ -L "$BATS_TEST_TMPDIR/link.json" ]
    [ "$(cat "$BATS_TEST_TMPDIR/real.json")" == new ]
}

@test "vdf launch options: \\n and \\t escapes survive a read and write" {
    f="$BATS_TEST_TMPDIR/localconfig.vdf"
    printf '%s\n' '"UserLocalConfigStore"' '{' '	"Software"' '	{' '		"Valve"' '		{' '			"Steam"' '			{' '				"apps"' '				{' '					"7"' '					{' '						"LaunchOptions"		"a\tb\\c"' '					}' '				}' '			}' '		}' '	}' '}' > "$f"
    v="$(vdf_get_launch_options "$f" 7)"
    [ "$v" == $'a\tb\\c' ]
    vdf_set_launch_options "$f" 7 "$v"
    grep -qF '"a\tb\\c"' "$f"
}

@test "wine registry strings are escaped when written" {
    f="$BATS_TEST_TMPDIR/user.reg"
    printf '%s\n' 'WINE REGISTRY Version 2' '' '[Software\\Test] 1' '"Name"="x"' > "$f"
    _wine_reg_set "$f" 'Software\Test' Name 'a"b\c'
    grep -qF '"Name"="a\"b\\c"' "$f"
}

@test "games_sharing_prefix: other installs with files in the same prefix" {
    mkdir -p "$BATS_TEST_TMPDIR/a" "$BATS_TEST_TMPDIR/b" "$BATS_TEST_TMPDIR/c"
    printf '%s\n' "/p/pfx/drive_c/windows/syswow64/dsound.dll" > "$BATS_TEST_TMPDIR/a/.eax-restore-manifest.txt"
    printf '%s\n' "/p/pfx/drive_c/windows/syswow64/dsound.dll" > "$BATS_TEST_TMPDIR/b/.eax-restore-manifest.txt"
    printf '%s\n' "/q/pfx/drive_c/windows/syswow64/dsound.dll" > "$BATS_TEST_TMPDIR/c/.eax-restore-manifest.txt"
    find_installed_game_dirs() { printf '%s\n' "$BATS_TEST_TMPDIR/a" "$BATS_TEST_TMPDIR/b" "$BATS_TEST_TMPDIR/c"; }
    run games_sharing_prefix /p/pfx "$BATS_TEST_TMPDIR/a"
    [ "$output" == "$BATS_TEST_TMPDIR/b" ]
}
