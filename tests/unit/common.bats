#!/usr/bin/env bats
# Small shared helpers in common.sh: names and paths, backups, quoting, the
# manifest's scope, and reading a selection like "1-3 ^2".

load ../helpers

setup() { load_script_functions; F="$BATS_TEST_TMPDIR/file"; }

@test "acf_value: reads name and installdir, ignoring indentation and other keys" {
    printf '"AppState"\n{\n\t"appid"\t\t"42"\n\t"name"\t\t"Half-Life: Source"\n\t"installdir"\t\t"Half-Life 2"\n}\n' > "$F"
    [ "$(acf_value "$F" name)" == "Half-Life: Source" ]
    [ "$(acf_value "$F" installdir)" == "Half-Life 2" ]
}

@test "acf_value: a missing key or file gives nothing" {
    printf '"AppState"\n{\n\t"appid"\t\t"42"\n}\n' > "$F"
    [ -z "$(acf_value "$F" name)" ]
    [ -z "$(acf_value "$BATS_TEST_TMPDIR/none" name)" ]
}

@test "acf_value: takes only the first match" {
    printf '\t"name"\t\t"One"\n\t"name"\t\t"Two"\n' > "$F"
    [ "$(acf_value "$F" name)" == "One" ]
}

@test "manifest_is_uninstalled: true only for the marker's first line" {
    echo "# EAX Restore: uninstalled on 2026-01-01T00:00:00Z. Nothing left to remove." > "$F"
    manifest_is_uninstalled "$F"
    printf '# EAX Restore manifest, format 2\n/a/dsound.dll\n' > "$F"
    ! manifest_is_uninstalled "$F"
    printf '/a/dsound.dll\n# EAX Restore: uninstalled later\n' > "$F"
    ! manifest_is_uninstalled "$F"
}

@test "manifest_is_uninstalled: a missing or empty file is not the marker" {
    ! manifest_is_uninstalled "$BATS_TEST_TMPDIR/none"
    : > "$F"
    ! manifest_is_uninstalled "$F"
}

@test "swap_in: replaces the target and keeps its permissions" {
    printf 'old\n' > "$F"; chmod 640 "$F"
    printf 'new\n' > "$F.tmp"
    swap_in "$F.tmp" "$F"
    [ "$(cat "$F")" == "new" ]
    [ "$(stat -c %a "$F")" == "640" ]
    [ ! -e "$F.tmp" ]
}

@test "swap_in: a target that does not exist yet is just created" {
    printf 'new\n' > "$F.tmp"
    swap_in "$F.tmp" "$F"
    [ "$(cat "$F")" == "new" ]
}

@test "swap_in: a failed move removes the temp file and returns 1" {
    printf 'new\n' > "$F.tmp"
    run swap_in "$F.tmp" "$BATS_TEST_TMPDIR/no/such/dir/file"
    [ "$status" -eq 1 ]
    [ ! -e "$F.tmp" ]
}

@test "print_final_step: wraps a long line under its label, short ones stay on one line" {
    NC="" YELLOW="" BOLD="" WHITE=""
    run print_final_step 1 "Launch the game:" "The DLL Override is set in Heroic's environment variables for Brothers in Arms - Road to Hill 30, so just hit Play."
    [ "$(wc -l <<< "$output")" -eq 2 ]
    while IFS= read -r l; do [ ${#l} -le 76 ]; done <<< "$output"
    [[ "$(head -1 <<< "$output")" == " 1. Launch the game: The DLL Override"* ]]
    [[ "$(tail -1 <<< "$output")" == "    "[a-z]* ]]
    run print_final_step 2 "Launch the game:" "Start the game as you normally would."
    [ "$output" == " 2. Launch the game: Start the game as you normally would." ]
}

# ---- from the script audits --------------------------------------------------

@test "manifest_file_is_ours: only the names the install deploys" {
    manifest_file_is_ours /g/dsound.dll
    manifest_file_is_ours /g/DSOUND.DLL
    manifest_file_is_ours /g/alsoft.ini
    ! manifest_file_is_ours /home/u/Documents
    ! manifest_file_is_ours /g/game.exe
}

@test "looks_like_our_file: DSOAL and generated files yes, a game's own no" {
    printf 'xxDSOALxx' > "$BATS_TEST_TMPDIR/dsound.dll"
    looks_like_our_file "$BATS_TEST_TMPDIR/dsound.dll"
    printf 'MZ genuine' > "$BATS_TEST_TMPDIR/other.dll"; mkdir "$BATS_TEST_TMPDIR/g"
    printf 'MZ genuine' > "$BATS_TEST_TMPDIR/g/dsound.dll"
    ! looks_like_our_file "$BATS_TEST_TMPDIR/g/dsound.dll"
    : > "$BATS_TEST_TMPDIR/g/eax.dll"
    looks_like_our_file "$BATS_TEST_TMPDIR/g/eax.dll"
    printf '# Auto-generated by EAX Restore Script for Linux\n' > "$BATS_TEST_TMPDIR/g/alsoft.ini"
    looks_like_our_file "$BATS_TEST_TMPDIR/g/alsoft.ini"
    printf '[general]\n' > "$BATS_TEST_TMPDIR/g/alsoft.ini"
    ! looks_like_our_file "$BATS_TEST_TMPDIR/g/alsoft.ini"
}

@test "oldest_backup: by the timestamp in the name, ignoring other .bak files" {
    f="$BATS_TEST_TMPDIR/dsound.dll"
    : > "$f.bak.20240102_000000"; : > "$f.bak.20230101_000000"; : > "$f.bak-mine"
    touch -d '2020-01-01' "$f.bak.20240102_000000"
    [ "$(oldest_backup "$f")" == "$f.bak.20230101_000000" ]
    rm "$f".bak.2*
    ! oldest_backup "$f"
}

@test "swap_in writes through a symlink and keeps it a symlink" {
    echo old > "$BATS_TEST_TMPDIR/real.json"
    ln -s real.json "$BATS_TEST_TMPDIR/link.json"
    echo new > "$BATS_TEST_TMPDIR/tmp"
    swap_in "$BATS_TEST_TMPDIR/tmp" "$BATS_TEST_TMPDIR/link.json"
    [ -L "$BATS_TEST_TMPDIR/link.json" ]
    [ "$(cat "$BATS_TEST_TMPDIR/real.json")" == new ]
}

@test "manifest_path_in_scope: the game folder and prefix drives only" {
    manifest_path_in_scope /g/Game/sub/dsound.dll /g/Game
    manifest_path_in_scope /h/pfx/drive_c/windows/system32/OpenAL32.dll /g/Game
    ! manifest_path_in_scope /g/Other/dsound.dll /g/Game
    ! manifest_path_in_scope /g/Game2/dsound.dll /g/Game
}

@test "shell_quote: a path with quotes, spaces and \$ survives sh -c" {
    local p="$BATS_TEST_TMPDIR/it's a \$dir \"x\""
    mkdir -p "$p"; touch "$p/f.reg"
    run sh -c "ls $(shell_quote "$p/f.reg")"
    [ "$status" -eq 0 ]
    [ "$output" == "$p/f.reg" ]
}

@test "find_glob_escape: an exe name with brackets matches only itself" {
    local d="$BATS_TEST_TMPDIR/g"; mkdir -p "$d"; touch "$d/Game [GOG].exe" "$d/Game G.exe"
    run find "$d" -type f -iname "$(find_glob_escape 'game [gog].exe')"
    [ "$output" == "$d/Game [GOG].exe" ]
}

# ---- parse_selection ---------------------------------------------------------

sel() { parse_selection "$1" "$2"; local i out=""; for ((i = 1; i <= $1; i++)); do out+="${SELECTED[$i]}"; done; echo "$out"; }

@test "parse_selection: empty input selects everything" {
    [ "$(sel 4 "")" == "1111" ]
}

@test "parse_selection: numbers and ranges narrow the selection" {
    [ "$(sel 5 "1 3")" == "10100" ]
    [ "$(sel 5 "2-4")" == "01110" ]
    [ "$(sel 5 "1,5")" == "10001" ]
}

@test "parse_selection: ^ excludes, whatever the order" {
    [ "$(sel 4 "^2")" == "1011" ]
    [ "$(sel 4 "^2 1-3")" == "1010" ]
    [ "$(sel 4 "1-3 ^2")" == "1010" ]
}

@test "parse_selection: unrecognised tokens are ignored" {
    [ "$(sel 3 "banana 2")" == "010" ]
}
