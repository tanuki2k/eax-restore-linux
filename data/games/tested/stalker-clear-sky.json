{
  "$schema": "../../schema.json",
  "name": "S.T.A.L.K.E.R.: Clear Sky",
  "description": "S.T.A.L.K.E.R.: Clear Sky is a singleplayer and multiplayer open-world first-person shooter and survival horror game and the second in the S.T.A.L.K.E.R. series.",
  "released": "2008-08-22",
  "exe": "xrEngine.exe",
  "stores": {
    "steam": { "id": 20510 },
    "gog": { "id": 1207660603 }
  },
  "eax": { "api": "openal", "versions": ["1.0", "2.0", "3.0"] },
  "game_config": {
    "files": {
      "user.ltx": {
        "format": "ltx",
        "locations": ["prefix_documents:Stalker-STCS/user.ltx", "game_root:_appdata_/user.ltx"],
        "crash_marker": "tmp.ltx"
      }
    },
    "audio_settings": [
      {
        "title": "Enable EAX sound effects",
        "reason": "EAX",
        "only_if": { "stores": ["gog"] },
        "changes": { "user.ltx": { "snd_efx": "on", "snd_device": "OpenAL Soft" } },
        "tested": true
      }
    ]
  }
}
