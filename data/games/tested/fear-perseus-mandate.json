{
  "$schema": "../../schema.json",
  "name": "F.E.A.R. Perseus Mandate",
  "description": "F.E.A.R. Perseus Mandate is a singleplayer and multiplayer first-person shooter and horror expansion for F.E.A.R.",
  "released": "2007-11-06",
  "exe": "FEARXP2.exe",
  "stores": {
    "steam": { "id": 21120 }
  },
  "eax": { "api": "directsound3d", "versions": ["2.0", "4.0"] },
  "install": {
    "tweaks": ["eax_unified", "expand_audio_limits"]
  },
  "game_config": {
    "files": {
      "Profile000.gdb": {
        "format": "gadb",
        "locations": ["prefix_public_documents:TimeGate Studios/FEARXP2/Profiles/Profile000.gdb"]
      }
    },
    "audio_settings": [
      {
        "title": "Enable EAX effects",
        "reason": "F.E.A.R. Perseus Mandate ships with its hardware sound and EAX options off, so it plays with no EAX reverb.",
        "changes": { "Profile000.gdb": { "UseHWSound": "1", "UseEAX": "1", "UseEAX4": "1" } }
      }
    ]
  },
  "sources": [
    {
      "title": "PCGamingWiki: F.E.A.R. Perseus Mandate",
      "url": "https://www.pcgamingwiki.com/wiki/F.E.A.R._Perseus_Mandate"
    }
  ]
}
