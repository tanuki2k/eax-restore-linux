{
  "$schema": "../../schema.json",
  "name": "Star Wars: Republic Commando",
  "description": "Star Wars: Republic Commando is a singleplayer and multiplayer first-person tactical shooter game in the Star Wars series.",
  "released": "2005-03-01",
  "exe": "SWRepublicCommando.exe",
  "stores": {
    "steam": { "id": 6000 },
    "gog": { "id": 1421405135 }
  },
  "eax": { "api": "openal", "versions": ["2.0", "3.0"] },
  "game_config": {
    "files": {
      "System.ini": { "format": "ini", "locations": ["game_root:GameData/Save/System.ini"] }
    },
    "audio_settings": [
      {
        "title": "Enable EAX reverb",
        "reason": "Republic Commando turns EAX and 3D sound off on its first launch and loads its bundled DefOpenAL32.dll instead of the OpenAL32.dll this script installs.",
        "changes": {
          "System.ini": {
            "ALAudio.ALAudioSubsystem": {
              "SelectedEAXVersion": "3",
              "UseEAX": "True",
              "Use3DSound": "True",
              "UseDefaultDriver": "False",
              "Channels": "32"
            }
          }
        },
        "tested": true
      }
    ],
    "optional_settings": [
      {
        "title": "MAX",
        "reason": "MAX",
        "changes": {
          "System.ini": {
            "WinDrv.WindowsClient": {
              "TextureDetailInterface": "UltraHigh",
              "TextureDetailTerrain": "UltraHigh",
              "TextureDetailWeaponSkin": "UltraHigh",
              "TextureDetailWorld": "UltraHigh",
              "TextureDetailRenderMap": "UltraHigh",
              "TextureDetailLightmap": "UltraHigh",
              "FSAA": "8",
              "BumpmappingQuality": "2",
              "Shadows": "True"
            }
          }
        }
      }
    ]
  }
}
