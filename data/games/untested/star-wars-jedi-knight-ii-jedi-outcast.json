{
  "$schema": "../../schema.json",
  "name": "Star Wars Jedi Knight II: Jedi Outcast",
  "exe": "jk2sp.exe",
  "stores": {
    "steam": { "id": 6030 },
    "gog": { "id": 1428935917 }
  },
  "eax": { "api": "openal", "versions": ["1.0", "2.0", "3.0"] },
  "game_config": {
    "files": {
      "jk2config.cfg": { "format": "idtech_cfg", "locations": ["game:base/jk2config.cfg"] },
      "jk2mpconfig.cfg": {
        "format": "idtech_cfg",
        "locations": ["game:base/jk2mpconfig.cfg"],
        "if_missing": "skip"
      }
    },
    "audio_settings": [
      {
        "title": "Enable EAX reverb",
        "reason": "Jedi Outcast only plays EAX reverb through its OpenAL sound option, which ships off in both single-player and multiplayer.",
        "changes": {
          "jk2config.cfg": { "s_UseOpenAL": "1" },
          "jk2mpconfig.cfg": { "s_UseOpenAL": "1" }
        }
      }
    ]
  }
}
