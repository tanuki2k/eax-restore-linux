{
  "$schema": "../../schema.json",
  "name": "Tom Clancy's Splinter Cell",
  "exe": "splintercell.exe",
  "stores": {
    "steam": { "id": 13560 },
    "gog": { "id": 1207659034 }
  },
  "eax": { "api": "directsound3d", "versions": ["1.0", "2.0", "3.0"] },
  "install": {
    "tweaks": ["eax_unified"]
  },
  "game_config": {
    "files": {
      "SplinterCellUser.ini": { "format": "ini", "locations": ["game:SplinterCellUser.ini"] }
    },
    "audio_fixes": [
      {
        "title": "Enable EAX reverb",
        "reason": "Splinter Cell ships with EAX and hardware 3D sound off.",
        "changes": {
          "SplinterCellUser.ini": {
            "Engine.EPCGameOptions": { "EAX": "True", "Sound3DAcc": "True" }
          }
        }
      }
    ]
  }
}
