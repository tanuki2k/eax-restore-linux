    "audio_settings": [
      {
        "title": "Enable EAX reverb",
        "reason": "Psychonauts ships with EAX off and has no in-game option to turn it on.",
        "changes": { "AudioSettings.ini": { "AudioSettings": { "UseEAX": "true" } } }
      }
    ]
  },
  "sources": [
    { "title": "PCGamingWiki: Psychonauts", "url": "https://www.pcgamingwiki.com/wiki/Psychonauts" }
