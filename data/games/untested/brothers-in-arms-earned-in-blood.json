{
  "$schema": "../../schema.json",
  "name": "Brothers in Arms: Earned in Blood",
  "exe": "EiB.exe",
  "stores": {
    "steam": { "id": 19800 },
    "gog": { "id": 1239584357 }
  },
  "eax": { "api": "openal", "versions": ["2.0", "3.0", "4.0"] },
  "game_config": {
    "files": { "EiB.ini": { "format": "ini", "locations": ["game:EiB.ini"] } },
    "audio_settings": [
      {
        "title": "Enable EAX reverb",
        "reason": "Earned in Blood ships with EAX and 3D sound off and loads its bundled DefOpenAL32.dll instead of the OpenAL32.dll this script installs.",
        "changes": {
          "EiB.ini": {
            "ALAudio.ALAudioSubsystem": {
              "UseDefaultDriver": "False",
              "UseEAX": "True",
              "Use3DSound": "True"
            }
          }
        }
      }
    ]
  }
}
