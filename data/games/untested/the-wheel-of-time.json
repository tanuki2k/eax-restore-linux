    "audio_fixes": [
      {
        "title": "Enable EAX reverb",
        "reason": "The Wheel of Time only plays EAX reverb when its DirectSound, hardware 3D sound and spatial sound options are on (per PCGamingWiki).",
        "changes": {
          "WoT.ini": {
            "Galaxy.GalaxyAudioSubsystem": {
              "UseDirectSound": "True",
              "Use3dHardware": "True",
              "UseSpatial": "True"
            }
          }
        }
      }
    ]
  },
  "sources": [
