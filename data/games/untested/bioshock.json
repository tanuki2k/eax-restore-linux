{
  "$schema": "../../schema.json",
  "name": "BioShock",
  "exe": "Bioshock.exe",
  "stores": {
    "steam": {
      "id": 7670,
      "store_details": "The original 2007 game, not 2016's 'BioShock Remastered'."
    }
  },
  "eax": { "api": "openal", "versions": ["4.0", "5.0"] },
  "game_config": {
    "files": {
      "Bioshock.ini": { "format": "ini", "locations": ["prefix_appdata:Bioshock/Bioshock.ini"] }
    },
    "audio_fixes": [
      {
        "title": "Enable EAX reverb",
        "reason": "BioShock ships with 'Use Creative EAX Audio' off, which keeps it on DirectSound with no EAX instead of the OpenAL32.dll this script installs (per Creative's audio guide for the game).",
        "changes": { "Bioshock.ini": { "ShockGame.ShockUserSettings": { "bEAXEnabled": "True" } } }
      }
    ]
  },
  "sources": [
    "https://web.archive.org/web/20080514015042/http://www.soundblaster.com/products/gaming/article.asp?articleID=71545&categoryID=13"
  ]
}
