{
  "$schema": "../schema.json",
  "name": "Brothers in Arms: Road to Hill 30",
  "exe": "bia.exe",
  "stores": {
    "steam": { "id": 15190 },
    "gog": { "id": 1993805983 }
  },
  "eax": { "api": "openal", "versions": ["2.0", "3.0", "4.0"] },
  "game_config": {
    "files": { "bia.ini": { "format": "ini", "locations": ["game:bia.ini"] } },
    "audio_fixes": [
      {
        "title": "Enable EAX reverb",
        "reason": "Brothers in Arms ships with EAX and 3D sound off and loads its bundled DefOpenAL32.dll instead of OpenAL32.dll.",
        "changes": {
          "bia.ini": {
            "ALAudio.ALAudioSubsystem": {
              "UseDefaultDriver": "False",
              "UseEAX": "True",
              "Use3DSound": "True"
            }
          }
        }
      }
    ]
  }
}
